# Copy to ConsTrack/.env on the server (next to docker-compose.yml) and fill in.

# Public hostname of the backend. Without a domain, use sslip.io: take the
# server's IPv4 address and replace dots with dashes, e.g. 203.0.113.10 ->
DOMAIN=203-0-113-10.sslip.io

# The Vercel frontend URL (no trailing slash). Only this origin may call the API.
CORS_ORIGIN=https://your-app.vercel.app
